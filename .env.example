APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://sso.ukpbj.demakkab.go.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- WhatsApp Gateway (Fonnte) — kirim password akun baru ---
FONNTE_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_TIMEOUT=15
FONNTE_COUNTRY_CODE=62

# --- Single Logout / OIDC Back-Channel Logout ---
# Queue HARUS async di produksi agar timeout satu SP tidak memblokir logout.
QUEUE_CONNECTION=database
SSO_LOGOUT_QUEUE=slo
SSO_LOGOUT_TOKEN_TTL=120
SSO_LOGOUT_TOKEN_LEEWAY=60
SSO_BACKCHANNEL_TIMEOUT=5
SSO_BACKCHANNEL_CONNECT_TIMEOUT=3
SSO_BACKCHANNEL_RETRY_MINUTES=15
# Wajib true di produksi; kosong = otomatis true saat APP_ENV=production.
SSO_POST_LOGOUT_REQUIRE_HTTPS=
# Opsional untuk client/SP yang memverifikasi lewat JWKS:
# SSO_JWKS_URI=https://sso.example.go.id/oauth/jwks
# SSO_JWK_KID=


# CSP form-action: origin aplikasi klien yang boleh menjadi tujuan akhir submit form login.
# Wajib diisi, jika tidak browser memblokir login SSO saat alur dimulai dari aplikasi klien.
# Pisahkan dengan koma bila lebih dari satu, mis.:
# SSO_FORM_ACTION_ORIGINS=https://simdesa.ukpbj.demakkab.go.id,https://simukpbj.demakkab.go.id
SSO_FORM_ACTION_ORIGINS=

